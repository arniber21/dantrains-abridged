{
	"name": "dantrains-abridged",
	"version": "0.1.1",
	"private": true,
	"description": "Build tooling for the Dan Trains Abridged subway-builder mod. The mod itself ships as index.js + manifest.json.",
	"scripts": {
		"build": "tsc -p tsconfig.json && node dist-scripts/build.js",
		"package": "npm run build && node dist-scripts/zip.js",
		"version": "node scripts/sync-manifest-version.js && git add manifest.json"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.1.2",
		"js-yaml": "^5.2.3",
		"typescript": "^7.0.2"
	}
}
