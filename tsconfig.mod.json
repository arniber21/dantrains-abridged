{
	"compilerOptions": {
		"target": "ES2020",
		"module": "es2020",
		"lib": ["ES2020"],
		"types": [],
		"outDir": "dist-mod",
		"rootDir": "src",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts"]
}
